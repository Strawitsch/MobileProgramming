<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5"
    android:gravity="center_horizontal"
    android:padding="24dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="24dp">

        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:src="@mipmap/ic_launcher"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bugs Game"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="?attr/colorPrimary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Главное меню"
            android:textSize="15sp"
            android:textColor="#666666"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <Button
                android:id="@+id/btnMenuGame"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="🎮 Играть"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnMenuRegistration"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="👤 Пользователи и регистрация"
                android:textSize="16sp"
                android:layout_marginBottom="12dp"
                style="?attr/materialButtonOutlinedStyle" />

            <Button
                android:id="@+id/btnMenuRecords"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="🏆 Рекорды"
                android:textSize="16sp"
                android:layout_marginBottom="12dp"
                style="?attr/materialButtonOutlinedStyle" />

            <Button
                android:id="@+id/btnMenuRules"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="📖 Правила игры"
                android:textSize="16sp"
                android:layout_marginBottom="12dp"
                style="?attr/materialButtonOutlinedStyle" />

            <Button
                android:id="@+id/btnMenuAuthors"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="ℹ️ Об авторах"
                android:textSize="16sp"
                android:layout_marginBottom="12dp"
                style="?attr/materialButtonOutlinedStyle" />

            <Button
                android:id="@+id/btnMenuSettings"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="⚙️ Настройки"
                android:textSize="16sp"
                android:layout_marginBottom="12dp"
                style="?attr/materialButtonOutlinedStyle" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
